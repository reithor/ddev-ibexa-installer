#!/bin/bash

if [[ ! -f composer.lock ]];then
  echo "❗️No composer.lock found                                   ❗️️"
  echo "❗️consider using ~/ddev-ibexa-installer/bin/create_project ❗️"
  exit
fi

if [ $# -eq 0 ]; then
  echo "❗️                                                         ❗️"
  echo "❗️No project name given, usage :                           ❗️️"
  echo "❗️~/ddev-ibexa-installer/bin/init_project my_project_name  ❗️"
  echo "❗️                                                         ❗️"
  echo "❗️To use current directory name as project name :          ❗️️"
  echo "❗️~/ddev-ibexa-installer/bin/init_project -                ❗️"
  echo "❗️                                                         ❗️"
  exit
fi

PROJECT_NAME="$1"

if [[ $PROJECT_NAME = '-' ]];then
  ddev config --project-type=php
else
  ddev config --project-type=php --project-name="$PROJECT_NAME"
fi

if [ ! $? -eq 0 ]; then
    exit
fi

ddev add-on get ~/ddev-ibexa-installer
ddev ibexa-configurator
ddev ibexa-setup
ddev ibexa-installer
