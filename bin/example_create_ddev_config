#!/bin/bash

#
# Script creates a .ddev configuration
# to kickstart a project with fixed settings.
# Kickstart by running:
# ddev start; ddev ibexa-setup; ddev ibexa-installer; 
#

if [ $(ls -A "$PWD" | wc -l) -ne 0 ]; then
  echo "❗️Script requires an empty directory ❗️"
  exit;
fi

ddev config --project-type=php
ddev add-on get ~/ddev-ibexa-installer

# fixed settings
cat <<EOF > .ddev/.ibexa-instance-settings
declare -- DXP_EDITION="experience"
declare -- PRODUCT_TYPE="Ibexa DXP Experience"
declare -- PRODUCT_VERSION="~4.6.x-dev"
declare -- PHP_VERSION="8.3"
declare -- NODE_VERSION="20"
declare -- DATABASE="mariadb"
declare -- DATABASE_VERSION="10.11"
declare -- HTTP_CACHE="varnish"
declare -- APP_CACHE="redis"
declare -- SEARCH_ENGINE="elasticsearch"
declare -- INSTALL_SAMPLE_DATA="false"
declare -- INSTALL_DEBUGBUNDLE="true"
declare -- APP_ENV="dev"
declare -- HTTP_SERVER="nginx-fpm"
declare -- INSTALL_CLOUD_CONFIG="true"
EOF

# remove config name - as it by default uses the current directory
sed -i '/^name:/d' .ddev/config.yaml

echo "👍 .ddev project configuration has been created inside current directory"
echo "👍 run:"
echo "👍 "
echo "👍 ddev start; ddev ibexa-setup; ddev ibexa-installer"
echo "👍 "
echo "👍 to kickstart the project´"
