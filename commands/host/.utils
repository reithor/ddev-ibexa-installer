#!/bin/bash

## #ddev-generated

export IBEXA_DXP_INSTALLED_LOCK_FILE=".ddev/.ibexa-dxp-installed"
export INSTANCE_SETTINGS_FILE=".ddev/.ibexa-instance-settings"
export VERBOSE_INSTALL=$(ddev exec printenv VERBOSE_INSTALL | tail -n 1)
export INITIAL_BRANCH=$(ddev exec printenv INITIAL_BRANCH 2>/dev/null | tail -n 1)
export INITIAL_BRANCH=${INITIAL_BRANCH:-main}

function verbose_output() {
    if [[ "$VERBOSE_INSTALL" == true ]]; then
        "$@"
    else
        "$@" > /dev/null
    fi
}

# Install log, written only when VERBOSE_INSTALL=true
# (relative to the project root, which is the working dir both on host and in the web container)
export INSTALL_LOG=".ddev/.ibexa-installer.log"

function execute_with_spinner() {
    TITLE="$1"
    shift

    if [[ "$VERBOSE_INSTALL" == true ]]; then
        echo "🚧 $TITLE"
        echo "### $TITLE: $*" >> "$INSTALL_LOG"
        ddev exec "$@" 2>&1 | tee -a "$INSTALL_LOG"
        return "${PIPESTATUS[0]}"
    else
        ddev gum spin --title "$TITLE" --timeout 0s -- "$@"
    fi
}

function bold() {
    ddev gum style --bold "$@"
}

function banner() {
    ddev gum style \
        --foreground "#FF4713" \
        --align center --width 90 \
        "" \
        "#%%*     =#                                                                     " \
        "%%%+   -#%%                                                                     " \
        "%#-    #%%%                                                                     " \
        ".  .   #%%%    ....                  ...                 .....       ...        " \
        " :**   #%%%:+#%%%%%%#+:          -+#%%%%%#+-           -#%%%*.  :=*%%%%%%#+-    " \
        "+%%*   #%%%%%%#*+++#%%%#-      +%%%%#+++*%%%%+.      :#%%%*:  :*%%%%**+*#%%%%=  " \
        "%%%*   #%%%%+.      .=%%%*   .#%%#=     .+%%%*..:  -#%%%+:   =%%%*:      .+%%%# " \
        "%%%*   #%%%-          :%%%=  *%%%.    .+%%%*:.*%%*#%%%*.    :%%%=          :%%%+" \
        "%%%*   #%%%            #%%*  %%%+   .+%%%*:   -%%%%%#:      +%%%            *%%%" \
        "%%%*   +%%%.           %%%+  #%%# .+%%%*:    -#%%%%%%*:     =%%%.           #%%%" \
        "%%%*   .%%%#:        .#%%#.  -%%%*%%%*-    -#%%%*:-*%%%*:    #%%#:        .*%%%%" \
        "%%%*    :#%%%*=::.:=*%%%#.    -%%%%%*:.:-+%%%%*.    :*%%%*:   *%%%*-:...-+%%%%%%" \
        "%%%*      -*%%%%%%%%%%*-       .=#%%%%%%%%%#+.        -#%%%*:  :*%%%%%%%%%%##%%=" \
        ""

    ddev gum style \
        --foreground "#FFFFFF" --faint --align center --width 90 \
        "~==[ $1 ]==~" \
        ""
}

function faint() {
    ddev gum style --faint "$@"
}

function error_handler() {
    echo ""
    echo "❌️  An error occurred. Exiting..."
    exit 1
}

function dependency_resolution_error() {
    echo ""
    if [[ "$VERBOSE_INSTALL" == true ]] && grep -q "your php version .* does not satisfy" "$INSTALL_LOG" 2>/dev/null; then
        echo "❗️ Some dependencies do not support PHP `(bold "$PHP_VERSION")` yet:"
        sed -nE 's/^ *- ([a-z0-9_.-]+\/[a-z0-9_.-]+)(\[[^]]*\]| [^ ]+) requires? php .*does not satisfy.*/\1/p' "$INSTALL_LOG" \
            | sort -u | sed 's/^/   • /'
        echo "Choose a different PHP version or wait until these packages declare support for PHP $PHP_VERSION."
    else
        echo "❗️ Composer could not resolve dependencies for `(bold "ibexa/$DXP_EDITION:$PRODUCT_VERSION")`"
    fi
    if [[ "$VERBOSE_INSTALL" == true ]]; then
        echo "Full output: `(faint "$INSTALL_LOG")`"
    else
        echo "Set `(faint "VERBOSE_INSTALL=true")` in `(faint ".ddev/config.installer.yaml")` and re-run to see the full output."
    fi
    exit 1
}

function check_composer_auth() {
    HAS_USERNAME=$(ddev composer config --list | grep http-basic.updates.ibexa.co.username)
    HAS_PASSWORD=$(ddev composer config --list | grep http-basic.updates.ibexa.co.password)

    if [[ ! "$HAS_USERNAME"  || ! "$HAS_PASSWORD" ]]; then
        echo "❌️  An error occurred. Can not connect to https://updates.ibexa.co"
        echo "❌️  username / password are missing "
        exit 1
    fi

    USERNAME=$(ddev composer config http-basic.updates.ibexa.co.username)
    PASSWORD=$(ddev composer config http-basic.updates.ibexa.co.password)
    HTTPRESPONSE=$(curl -Isu $USERNAME:$PASSWORD https://updates.ibexa.co | head -n 1)


    if [[ ! "$HTTPRESPONSE" == *"HTTP/2 200"* ]]; then
        echo "❌️  An error occurred. Can not connect to https://updates.ibexa.co"
    fi
}

# Set custom error handler
trap 'error_handler' ERR
