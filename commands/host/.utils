#!/bin/bash

## #ddev-generated

export IBEXA_DXP_INSTALLED_LOCK_FILE=".ddev/.ibexa-dxp-installed"
export INSTANCE_SETTINGS_FILE=".ddev/.ibexa-instance-settings"
export VERBOSE_INSTALL=$(ddev exec printenv VERBOSE_INSTALL | tail -n 1)

function verbose_output() {
    if [[ "$VERBOSE_INSTALL" == true ]]; then
        "$@"
    else
        "$@" > /dev/null
    fi
}

function execute_with_spinner() {
    TITLE="$1"
    shift

    if [[ "$VERBOSE_INSTALL" == true ]]; then
        ddev exec "$@"
    else
        ddev gum spin --title "$TITLE" --timeout 0s -- "$@"
    fi
}

function bold() {
    ddev gum style --bold "$@"
}

function banner() {
    ddev gum style \
        --foreground "#FF4713" \
        --align center --width 90 \
        "" \
        "#%%*     =#                                                                     " \
        "%%%+   -#%%                                                                     " \
        "%#-    #%%%                                                                     " \
        ".  .   #%%%    ....                  ...                 .....       ...        " \
        " :**   #%%%:+#%%%%%%#+:          -+#%%%%%#+-           -#%%%*.  :=*%%%%%%#+-    " \
        "+%%*   #%%%%%%#*+++#%%%#-      +%%%%#+++*%%%%+.      :#%%%*:  :*%%%%**+*#%%%%=  " \
        "%%%*   #%%%%+.      .=%%%*   .#%%#=     .+%%%*..:  -#%%%+:   =%%%*:      .+%%%# " \
        "%%%*   #%%%-          :%%%=  *%%%.    .+%%%*:.*%%*#%%%*.    :%%%=          :%%%+" \
        "%%%*   #%%%            #%%*  %%%+   .+%%%*:   -%%%%%#:      +%%%            *%%%" \
        "%%%*   +%%%.           %%%+  #%%# .+%%%*:    -#%%%%%%*:     =%%%.           #%%%" \
        "%%%*   .%%%#:        .#%%#.  -%%%*%%%*-    -#%%%*:-*%%%*:    #%%#:        .*%%%%" \
        "%%%*    :#%%%*=::.:=*%%%#.    -%%%%%*:.:-+%%%%*.    :*%%%*:   *%%%*-:...-+%%%%%%" \
        "%%%*      -*%%%%%%%%%%*-       .=#%%%%%%%%%#+.        -#%%%*:  :*%%%%%%%%%%##%%=" \
        ""

    ddev gum style \
        --foreground "#FFFFFF" --faint --align center --width 90 \
        "~==[ $1 ]==~" \
        ""
}

function faint() {
    ddev gum style --faint "$@"
}

function error_handler() {
    echo ""
    echo "❌️  An error occurred. Exiting..."
    exit 1
}

function check_composer_auth() {
    HAS_USERNAME=$(ddev composer config --list | grep http-basic.updates.ibexa.co.username)
    HAS_PASSWORD=$(ddev composer config --list | grep http-basic.updates.ibexa.co.password)

    if [[ ! "$HAS_USERNAME"  || ! "$HAS_PASSWORD" ]]; then
        echo "❌️  An error occurred. Can not connect to https://updates.ibexa.co"
        echo "❌️  username / password are missing "
        exit 1
    fi

    USERNAME=$(ddev composer config http-basic.updates.ibexa.co.username)
    PASSWORD=$(ddev composer config http-basic.updates.ibexa.co.password)
    HTTPRESPONSE=$(curl -Isu $USERNAME:$PASSWORD https://updates.ibexa.co | head -n 1)


    if [[ ! "$HTTPRESPONSE" == *"HTTP/2 200"* ]]; then
        echo "❌️  An error occurred. Can not connect to https://updates.ibexa.co"
    fi
}

# Set custom error handler
trap 'error_handler' ERR
